{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "prisma": {
      "type": "local",
      "command": ["npx", "prisma", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
