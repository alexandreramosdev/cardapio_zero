# Banco de dados (Neon / PostgreSQL)
# Conexão com pooling, usada pela aplicação em runtime
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.regiao.aws.neon.tech/DB?sslmode=require"
# Conexão direta, usada pelas migrations do Prisma (prisma migrate)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.regiao.aws.neon.tech/DB?sslmode=require"

# Auth.js
# Gere um segredo com: npx auth secret (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Seed (npx prisma db seed) — credenciais do admin demo
SEED_ADMIN_EMAIL="admin@exemplo.dev"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
